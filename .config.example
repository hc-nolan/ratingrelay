# RatingRelay settings.
#
# Copy to `.config` (gitignored) and edit. Values here are read by
# pydantic-settings in ratingrelay/settings.py; environment variables of the
# same name override this file.
#
# Every service credential below is OPTIONAL. Anything left out is expected to
# be entered in the web UI and stored in the database; a value set here takes
# precedence over the database one (useful for dev and for headless runs).

# --- App ---------------------------------------------------------------
# Where the API listens. Keep base_url in sync: it is what Plex redirects to
# during OAuth, so it must be reachable from the browser, not just locally.
# Leave base_url on localhost and the callback follows whichever origin the
# browser used, so the app works over the LAN without editing this. Set it to a
# real address and that address wins, which is what a deployed instance wants.
host = "0.0.0.0"
port = 8100
base_url = "http://localhost:8100"

# Directory holding the built SvelteKit bundle (only used when serving the
# frontend from FastAPI; the dev server is on :5173).
frontend_dir = "frontend/build"

# SQLite file. Relative paths resolve from the working directory.
database = "ratingrelay.db"

log_level = "INFO"
timezone = "America/Toronto"

# Server-side session secret. Generate with: openssl rand -hex 32
# Sessions are signed with this *and* the Plex token, so rotating either one
# signs every browser out.
secret = "CHANGE-ME"

# Require a Plex login for the API. Only turn this off when the relay is
# reachable from nothing but its own machine.
auth = true

# --- Plex --------------------------------------------------------------
# Full URL including port, e.g. http://192.168.0.10:32400
# plex_server_url = ""
plex_music_library = "Music"
# plex_token = ""

# --- Last.fm -----------------------------------------------------------
# API credentials: https://www.last.fm/api/account/create
# lastfm_token = ""      # API key
# lastfm_secret = ""
# lastfm_username = ""
# lastfm_password = ""

# --- ListenBrainz ------------------------------------------------------
# Token: https://listenbrainz.org/settings/
# listenbrainz_token = ""
# listenbrainz_username = ""
