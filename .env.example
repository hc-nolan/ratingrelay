# Copy to .env next to compose.yaml. Docker Compose reads it automatically.

# Required. Signs the login cookie. Generate with: openssl rand -hex 32
RATINGRELAY_SECRET=

# Port on this machine the web app is published on.
RATINGRELAY_PORT=8100

# Time zone for times shown in the UI (IANA name, e.g. America/Toronto).
RATINGRELAY_TIMEZONE=UTC

# The Plex ratings that count as a love (at least) and a hate (at most) are set
# in the web app (defaults 4 stars and 1 star). Set one here only to pin it: the
# app then shows it read-only. Out of 10, so 8 is 4 stars; hate below love.
# RATINGRELAY_LOVE_THRESHOLD=8
# RATINGRELAY_HATE_THRESHOLD=2
