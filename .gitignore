# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Local configuration and secrets. Never commit these.
.config
*.env
relays.toml

# Databases
*.db
# A copy taken before a risky change is still the same database, with the same
# credential rows in it: `ratingrelay.db.bak-…` is not matched by `*.db`.
*.db.bak*
*.db-journal
*.db-wal
*.db-shm

# Tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Frontend
node_modules/
frontend/build/
frontend/.svelte-kit/

# Editor / OS
.DS_Store
.playwright-mcp/
