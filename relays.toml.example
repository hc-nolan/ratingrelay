# The relays `ratingrelay run` executes, in order. Copy to `relays.toml`.
#
# Every key below is optional except `source` and `targets`; unknown keys are an
# error on purpose. Secrets never live here — the CLI reads credentials from
# `.config` (or the environment), then from the relay's database.

[[relay]]
name = "nightly"
source = "plex"
targets = ["lastfm", "listenbrainz"]
# Loves or hates. The Plex ratings that count as each are the love/hate
# thresholds set in the web app (or pinned by LOVE_THRESHOLD / HATE_THRESHOLD),
# shared by every relay: a Plex source reads them and a Plex target writes them.
feedback_type = "love"      # love or hate
# dry_run = true            # fetch, match and reconcile, but write nothing
# reapply_target_drift = true
#   Write again what this relay's targets have since dropped (an un-loved
#   track on Last.fm, a cleared rating on Plex). Off by default: a target's own
#   edits are left alone. A write the target still holds, or one it replaced
#   with a different value, is never overwritten.

# The pair runs this way round too: Last.fm becomes the source of truth, and
# Plex the target that follows it.
[[relay]]
name = "back-to-plex"
source = "lastfm"
targets = ["plex"]

# Hyperfix as the source of truth: its music module holds the ratings, and this
# relay mirrors them outward. A hyperfix source cannot target Plex (hyperfix
# writes Plex itself), so the targets here are the other two.
[[relay]]
name = "from-hyperfix"
source = "hyperfix"
targets = ["lastfm", "listenbrainz"]

# Or hyperfix as a target: the ratings land in its music module, which stores
# them as 0-100 and pushes them on to Plex itself.
[[relay]]
name = "into-hyperfix"
source = "lastfm"
targets = ["hyperfix"]

# A second account of a service is named after the colon. Add it on the Services
# page first; the account that was already connected keeps the bare name. A
# second Plex server (targets = ["plex:attic"]) and a second ListenBrainz account
# work the same way. The ref is whichever account you named when you added it.
# [[relay]]
# name = "move-to-new-account"
# source = "lastfm"
# targets = ["lastfm:new"]
